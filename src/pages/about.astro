---
<Base title="About" description="Stéphane AHOLOU-BAH, AI Scientist based in Benin (IFRI-UAC). NLP, ASR, NeuroAI, and ML for health.">
  <div class="container about-grid">
    <!-- Aside -->
    <aside class="about-aside">
      <img class="about-photo" src="/assets/img/image.jpg" alt="Stéphane AHOLOU-BAH" width="260" height="325" />
      <div class="about-links">
        <a class="about-link" href={`mailto:${SITE.email}`}><Icon name="mail" size={16} /> {SITE.email}</a>
        <a class="about-link" href={SITE.social.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> github.com/StephaneBah</a>
        <a class="about-link" href={SITE.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> linkedin.com/in/stephanebah</a>
        <a class="about-link cv" href={SITE.cv} target="_blank" rel="noopener"><Icon name="cv" size={16} /> Download CV</a>
      </div>
    </aside>

    <!-- Main -->
    <div>
      <h1 class="about-name">Stéphane AHOLOU-BAH</h1>
      <p class="about-role">AI Scientist · Aspiring Researcher</p>
      <p class="about-bio">I am driven by the application of artificial intelligence to real-world challenges: health, public safety, resource optimisation, and language processing. My goal is to design AI solutions that improve efficiency, decision-making, and accessibility.</p>

      <section class="about-block">
        <h2>Focus Areas</h2>
        <div class="chip-row">{focus.map((f) => <span class="chip">{f}</span>)}</div>
      </section>

      <section class="about-block">
        <h2>Technical Stack</h2>
        <div class="chip-row">{stack.map((s) => <span class="chip">{s}</span>)}</div>
      </section>

      <section class="about-block">
        <h2>Education</h2>
        <div class="timeline">
          {education.map((e) => (
            <div class="tl-item">
              <div class="tl-head">
                <span class="tl-title">{e.title}</span>
                <span class="tl-date">{e.date}</span>
              </div>
              <p class="tl-org">
                {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.org} ↗</a> : e.org}
              </p>
              <p class="tl-desc" style="white-space: pre-line;">{e.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="about-block">
        <h2>Experience &amp; Engagements</h2>
        <div class="timeline">
          {experience.map((e) => (
            <div class="tl-item">
              <div class="tl-head">
                <span class="tl-title">{e.title}</span>
                <span class="tl-date">{e.date}</span>
              </div>
              <p class="tl-org">
                {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.org} ↗</a> : e.org}
              </p>
              <p class="tl-desc">{e.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="about-block">
        <h2>Awards &amp; Distinctions</h2>
        <div class="timeline">
          {awards.map((a) => (
            <div class="tl-item">
              <div class="tl-head">
                <span class="tl-title">{a.title}</span>
                <span class="tl-date">{a.date}</span>
              </div>
              <p class="tl-org">
                {a.url ? <a href={a.url} target="_blank" rel="noopener">{a.org} ↗</a> : a.org}
              </p>
              {a.desc && <p class="tl-desc">{a.desc}</p>}
            </div>
          ))}
        </div>
      </section>

      <section class="about-block">
        <h2>Certifications</h2>
        <div class="timeline">
          {certificates.map((c) => (
            <div class="tl-item">
              <div class="tl-head">
                <span class="tl-title">{c.title}</span>
                <span class="tl-date">{c.date}</span>
              </div>
              <p class="tl-org">
                {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.org} ↗</a> : c.org}
              </p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

