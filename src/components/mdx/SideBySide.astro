---
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---
<figure class="side-by-side-wrapper breakout">
  <div class="side-by-side-grid">
    <slot />
  </div>
  {caption && <figcaption class="side-by-side-caption">{caption}</figcaption>}
</figure>

<style>
  .side-by-side-wrapper {
    margin-block: 2.2rem;
  }
  .side-by-side-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .side-by-side-grid :global(> *) {
    min-width: 0;
    margin: 0 !important;
  }
  .side-by-side-grid :global(pre) {
    height: 100%;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .side-by-side-grid :global(img) {
    height: 100%;
    object-fit: contain;
    margin: 0 !important;
    border-radius: var(--radius);
  }
  .side-by-side-caption {
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-tertiary);
    margin-top: 0.75rem;
    font-style: normal;
  }
  @media (max-width: 768px) {
    .side-by-side-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
