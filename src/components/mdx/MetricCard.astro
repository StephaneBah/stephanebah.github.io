---
interface Props {
  label: string;
  before?: string;
  after: string;
  delta?: string;
  description?: string;
}
const { label, before, after, delta, description } = Astro.props;
---
<div class="metric-card">
  <div class="metric-header">
    <span class="metric-label">{label}</span>
    {delta && <span class="metric-delta">{delta}</span>}
  </div>
  <div class="metric-values">
    {before && (
      <div class="metric-val before">
        <span class="metric-sublabel">Avant</span>
        <span class="metric-number">{before}</span>
      </div>
    )}
    {before && <span class="metric-arrow">→</span>}
    <div class="metric-val after">
      <span class="metric-sublabel">{before ? 'Après' : 'Résultat'}</span>
      <span class="metric-number highlighted">{after}</span>
    </div>
  </div>
  {description && <p class="metric-desc">{description}</p>}
</div>

<style>
  .metric-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.4rem 1.6rem;
    margin-block: 1.8rem;
    box-shadow: var(--shadow-sm);
  }
  .metric-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
  }
  .metric-delta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: #047857;
    background: #d1fae5;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .metric-values {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
  }
  .metric-val {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .metric-sublabel {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .metric-number {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--text-secondary);
  }
  .metric-number.highlighted {
    color: var(--primary);
    font-weight: 600;
  }
  .metric-arrow {
    font-size: 1.5rem;
    color: var(--text-tertiary);
  }
  .metric-desc {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
</style>
